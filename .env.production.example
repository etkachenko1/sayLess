# Generate each password/secret below with: openssl rand -hex 32
JWT_SECRET=
MONGO_ROOT_USERNAME=sayless_admin
MONGO_ROOT_PASSWORD=
KAFKA_USERNAME=sayless_kafka
KAFKA_PASSWORD=
AI_OPERATOR_SECRET=

DOMAIN=sayless.site

CORS_ALLOWED_ORIGINS=https://sayless.site

# Caddy's static IP on the compose network (docker-compose.yml pins it there).
# Trusting this address is what lets the login lockout and the gateway's rate
# limiter read the real client IP from X-Forwarded-For instead of Caddy's own.
TRUSTED_PROXY_IP=172.28.0.200

# Leave empty unless the host runs out of memory. Example: -Xmx256m -Xms128m
JAVA_OPTS=